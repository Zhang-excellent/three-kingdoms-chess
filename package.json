{
  "name": "three-kingdoms-chess",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "accept:home": "node scripts/home-browser-acceptance.mjs",
    "accept:three-kingdoms": "node scripts/three-kingdoms-browser-acceptance.mjs",
    "accept:chinese": "node scripts/chinese-browser-acceptance.mjs",
    "accept:mist": "node scripts/mist-chess-browser-acceptance.mjs",
    "accept:mist-history": "node scripts/mist-history-browser-acceptance.mjs",
    "accept:other-games": "node scripts/other-games-browser-acceptance.mjs",
    "accept:beast": "node scripts/beast-chess-browser-acceptance.mjs",
    "accept:pikafish": "node scripts/pikafish-browser-acceptance.mjs",
    "engine:check": "node --import tsx scripts/check-pikafish.mjs",
    "engine:play-check": "node --import tsx scripts/check-pikafish-game.mjs",
    "start": "tsx server/index.ts",
    "check": "vue-tsc --noEmit",
    "test": "node scripts/test.mjs",
    "build": "node scripts/build.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:apk:debug",
    "android:apk:debug": "npm run android:sync && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-debug.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "express": "^5.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@happy-dom/global-registrator": "21.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  }
}
